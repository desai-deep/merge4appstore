# App Store Connect API credentials (required)
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=

# GitHub PAT fallback. Production deployment still requires this for its
# bounded classic-hook reconciler and branch-head preparation smoke.
GH_TOKEN=

# Optional GitHub App authentication. Set both values or neither.
GITHUB_APP_ID=
# Base64-encode the complete PEM so deployment environment files stay one line per value.
GITHUB_APP_PRIVATE_KEY_BASE64=
# Optional fast path supplied by App webhooks; otherwise discovered per repository.
# Set only when the authentication pair above is configured.
GITHUB_INSTALLATION_ID=

# Optional GitHub App webhook cutover group. Set all three or none. Shadow mode
# requires classic=true; managed mode requires classic=false.
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_MODE=
GITHUB_CLASSIC_WEBHOOKS_ENABLED=

# Webhook authentication (names may be overridden per repository profile)
GH_WEBHOOK_SECRET=
XCODE_CLOUD_WEBHOOK_TOKEN=
MERGE4APPSTORE_BUILD_TOKEN_JAMSONTOAST=
MERGE4APPSTORE_BUILD_TOKEN_RUNNINGORDER_IOS=

# Legacy environment-only app configuration (not needed with --profile)
APP_BUNDLE_ID=
APP_NAME=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Optional configuration
# INSTANCE_NAME=            # Unique lock/log name when one checkout handles multiple apps
# APP_ID=                   # App Store Connect app ID (use if bundle ID matches multiple apps)
# XCODE_WORKFLOW_ID=        # Xcode Cloud workflow ID to filter builds
# RECOVER_MISSED_XCODE_BUILDS=false # Start the production workflow when a merged PR has no build run
# IOS_REPO_PATH=            # Local path to iOS repo (for auto-triggering next TestFlight build)
# PRODUCTION_BRANCH=main    # Branch whose workflow builds are eligible for release
# BETA_BRANCH=develop       # Branch triggered after a release goes live
# EXPIRE_MERGED_BUILDS=true  # Set false to disable closed-PR expiry in the default mode
# DRY_RUN=true              # Run without making changes
# MERGE4APPSTORE_PROFILE=profiles/runningorder.yml
# MERGE4APPSTORE_ENV=/srv/merge4appstore/.env # Shared App Store Connect/GitHub credential file
# MERGE4APPSTORE_WEBHOOK_ENV=/srv/merge4appstore.state/current-webhook.env # Webhook-only 0600 override file
# MERGE4APPSTORE_STATE_DIR=/srv/merge4appstore.state # Absolute private runtime/deployment state directory
# MERGE4APPSTORE_MIRROR_TTL_MS=60000
# MERGE4APPSTORE_MIRROR_TIMEOUT_MS=15000
# MERGE4APPSTORE_MIRROR_PREWARM_TIMEOUT_MS=60000
# MERGE4APPSTORE_MIRROR_PREWARM_FETCH_TIMEOUT_MS=120000
# MERGE4APPSTORE_MIRROR_CLONE_TIMEOUT_MS=120000
# MERGE4APPSTORE_MIRROR_REQUEST_LOCK_TIMEOUT_MS=5000
# MERGE4APPSTORE_MIRROR_PREWARM_LOCK_TIMEOUT_MS=60000
# MERGE4APPSTORE_MIRROR_RETRY_BACKOFF_MS=5000
# MERGE4APPSTORE_MIRROR_CANDIDATE_LIMIT=20
# MERGE4APPSTORE_PREPARE_TIMEOUT_MS=45000
# MERGE4APPSTORE_DRAIN_TIMEOUT_MS=600000
# MERGE4APPSTORE_LEGACY_DRAIN_QUIET_SECONDS=30
# MERGE4APPSTORE_DELIVERY_PAUSE_FILE=/srv/merge4appstore.state/delivery.pause
# MERGE4APPSTORE_RECOVERY_INTERVAL_MS=5000
# MERGE4APPSTORE_JOB_RETRY_MS=5000
# MERGE4APPSTORE_JOB_MAX_ATTEMPTS=8
