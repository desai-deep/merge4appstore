# App Store Connect API credentials (required)
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=

# GitHub token for PR comments (required for gh CLI)
GH_TOKEN=

# App configuration (required)
APP_BUNDLE_ID=
APP_NAME=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Optional configuration
# APP_ID=                   # App Store Connect app ID (use if bundle ID matches multiple apps)
# XCODE_WORKFLOW_ID=        # Xcode Cloud workflow ID to filter builds
# IOS_REPO_PATH=            # Local path to iOS repo (for auto-triggering next TestFlight build)
# DRY_RUN=true              # Run without making changes

# Webhook server (server.js) configuration
XCODE_WEBHOOK_SECRET=                 # shared secret authenticating Xcode Cloud webhooks (required by server.js)
# WEBHOOK_PORT=8090                   # port to listen on (bound to 127.0.0.1)
# WEBHOOK_RETRY_INTERVAL_MS=180000    # delay between deploy retries while a build finishes processing
# WEBHOOK_RETRY_MAX_ATTEMPTS=20       # max deploy attempts per webhook trigger
